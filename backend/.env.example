PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=lakshadweep_objections_db
DB_CONNECTION_LIMIT=15

JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# Edge / Chrome binary path for Puppeteer (auto-detected on Windows/Linux if omitted)
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Public URL for downloads & CORS
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# File Upload & PDF Storage Directories
UPLOAD_DIR=./uploads
PDF_STORAGE_DIR=./storage/pdfs
