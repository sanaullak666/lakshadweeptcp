PORT=5000
NODE_ENV=development

# Option A: Supabase / PostgreSQL (Active)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_TYPE=postgres

# Option B: Local / Cloud MySQL (Alternative)
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=lakshadweep_objections_db
DB_CONNECTION_LIMIT=15

JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# Edge / Chrome binary path for Puppeteer (auto-detected on Windows/Linux if omitted)
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Public URL for downloads & CORS
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# File Upload & PDF Storage Directories
UPLOAD_DIR=./uploads
PDF_STORAGE_DIR=./storage/pdfs
